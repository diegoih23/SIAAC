DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DB_ENGINE=django.db.backends.mysql
DB_NAME=siaac_db
DB_USER=siaac_user
DB_PASSWORD=siaac_password
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173
REDIS_URL=redis://127.0.0.1:6379/0
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

YOLO_MODEL_PATH=ml/yolo/weights/yolo11n.pt
YOLO_CONFIDENCE=0.45
YOLO_DEVICE=cpu
DEVICE_API_KEY=cambia-la-clave-del-dispositivo
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883

# Para desarrollo sin SMTP usa console.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=seguridad@siaac.local
