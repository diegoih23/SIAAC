# Copiar a .env y ajustar valores locales
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de datos MariaDB
DB_ENGINE=django.db.backends.mysql
DB_NAME=siaac_db
DB_USER=siaac_user
DB_PASSWORD=siaac_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Redis (Channels / caché)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# IA / YOLO
YOLO_MODEL_PATH=ml/yolo/weights/yolo11n.pt
YOLO_CONFIDENCE=0.45
YOLO_DEVICE=cpu

# Hardware
DEVICE_API_KEY=clave-compartida-esp32
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
