# Copiar a hardware/raspberry_pi/config/.env
SIAAC_API_URL=http://192.168.1.100:8000/api/v1
DEVICE_SERIAL=RPI-SIAAC-001
DEVICE_API_KEY=demo-api-key-rpi-001
ZONE_ID=1

CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
FPS=5

YOLO_WEIGHTS=models/siaac_intrusos.pt
YOLO_CONFIDENCE=0.45
YOLO_DEVICE=cpu
YOLO_CLASSES=person,dog,cat,bird,car,motorcycle
COOLDOWN_SECONDS=10
SAVE_EVIDENCE=true
EVIDENCE_DIR=evidence

MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_TOPIC_COMMANDS=siaac/zones/1/commands
